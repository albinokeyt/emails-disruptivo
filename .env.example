# =============================================================================
# Emails Disruptivo — variables de entorno
# Copia este fichero a .env y rellena los valores. Las marcadas OBLIGATORIA tienen
# que estar: sin ellas la app se niega a arrancar y dice cuál falta.
# =============================================================================

# Puerto HTTP del panel y de la API (en EasyPanel, 8080).
PORT=8080

# OBLIGATORIA. Postgres 17. En EasyPanel usa el host interno que te muestra el servicio.
DATABASE_URL=postgres://postgres:CAMBIA_ESTO@emails-db:5432/emails

# OBLIGATORIA. Redis 7: sesiones, locks de refresco de token y límites de envío.
REDIS_URL=redis://emails-redis:6379

# OBLIGATORIA. URL pública final, SIN barra al final y con HTTPS.
# Con ella se construyen la Redirect URL del OAuth, las URLs de seguimiento que van dentro de cada
# correo, las URLs de webhook que se registran en Brevo y, por defecto, el host del relay SMTP.
# Cambiarla después deja apuntando al dominio viejo todo el correo ya enviado.
APP_BASE_URL=https://emails.tudominio.com

# OBLIGATORIA. 32 bytes en base64 (o 64 caracteres hex). Cifra en AES-256-GCM las credenciales de
# los proveedores de correo y la clave privada del certificado TLS del relay.
# Genérala con:  openssl rand -base64 32
# Si la pierdes o la cambias, esas credenciales dejan de poder descifrarse y hay que volver a
# meterlas proveedor a proveedor (el certificado se vuelve a emitir solo). Para rotarla sin cortar
# el servicio se admiten varias separadas por comas: la primera cifra y todas se prueban al
# descifrar ("nueva,vieja").
ENCRYPTION_KEY=CAMBIA_ESTO

# OBLIGATORIAS. Login del panel de la agencia (/admin). Usa una contraseña larga y única.
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTO

# --- Relay SMTP (opcional; la sección activable del panel) -------------------
# Levanta el servidor SMTP que recibe el correo del nodo NATIVO de GoHighLevel.
# Encenderlo son unos pocos pasos (DEPLOY.md §D): el certificado TLS lo lee del acme.json de
# Traefik (SMTP_RELAY_TRAEFIK_ACME, abajo); nada a mano.
SMTP_RELAY_ENABLED=false

# Escuchas DENTRO del contenedor. Son puertos altos a propósito: se abren sin privilegios y
# EasyPanel (Ports) los publica como 587 → 2525 y 465 → 2465, ambos TCP.
#   SMTP_RELAY_PORT      escucha TLS/STARTTLS.
#   SMTP_RELAY_PORT_SSL  escucha SSL (TLS implícito). Déjala VACÍA si no quieres levantarla.
SMTP_RELAY_PORT=2525
SMTP_RELAY_PORT_SSL=2465

# Puertos PÚBLICOS: los que EasyPanel publica hacia las escuchas de arriba y los que el panel
# enseña a las subcuentas para pegar en GHL. Cámbialos solo si publicas otros de verdad.
# (docker-compose también usa SMTP_RELAY_PUBLIC_PORT para publicar el puerto en el host.)
SMTP_RELAY_PUBLIC_PORT=587
SMTP_RELAY_PUBLIC_PORT_SSL=465

# Host del relay: el que ve el cliente en GHL y cuyo certificado se usa.
# Déjalo SIN definir para usar el dominio de APP_BASE_URL (recomendado: Traefik ya tiene su
# certificado). Si pones otro (p. ej. smtp.tudominio.com), dalo de alta CON HTTPS en Domains de
# EasyPanel para que Traefik le emita el suyo (DEPLOY.md §D7).
# SMTP_RELAY_HOST=smtp.tudominio.com

# Certificado del relay. Precedencia: ficheros > Traefik > ACME propio > autofirmado.
#
# MODO TRAEFIK (el que funciona en EasyPanel, DEPLOY.md §D1-D3): ruta, DENTRO del contenedor, del
# acme.json de Traefik, que ya contiene y renueva el certificado del host. Se monta el directorio de
# Traefik del VPS (normalmente /etc/easypanel/traefik) en /certs, en solo lectura. Con esta variable
# la app no llama nunca a Let's Encrypt: lee el certificado, lo aplica en caliente y lo relee cuando
# Traefik lo renueva. Ruta absoluta.
# SMTP_RELAY_TRAEFIK_ACME=/certs/acme.json

# MODO ACME PROPIO (HTTP-01 desde la app, DEPLOY.md §D6): solo sin SMTP_RELAY_TRAEFIK_ACME y solo si
# el puerto 80 del host entrega el reto a esta app. Detrás de Traefik con ACME (EasyPanel) NO
# funciona: su manejador ACME captura /.well-known/acme-challenge/ para todos los hosts. true por
# defecto; se emite al arrancar, se aplica en caliente y se renueva cuando quedan menos de 30 días.
SMTP_RELAY_TLS_AUTO=true

# Contacto opcional de la cuenta ACME (modo ACME propio): Let's Encrypt avisa ahí si un certificado
# va a caducar sin renovarse.
# ACME_EMAIL=admin@tudominio.com

# Directorio ACME (modo ACME propio). Sin definir = producción de Let's Encrypt. Para pruebas sin
# gastar cuota, "staging" (su certificado no es de confianza para nadie: quítalo antes de dárselo a
# un cliente).
# ACME_DIRECTORY=staging

# Certificado MANUAL en ficheros, dentro del contenedor. Tiene prioridad sobre Traefik y sobre el
# automático. Solo para un host que no enrute a este servidor (reto DNS-01 + volumen, DEPLOY.md
# §D7). Las dos van juntas: o las dos o ninguna. Se leen al arrancar: reinicia tras renovarlos.
# SMTP_RELAY_TLS_CERT=/certs/fullchain.pem
# SMTP_RELAY_TLS_KEY=/certs/privkey.pem

# Tamaño máximo de un mensaje entrante, en bytes (25 MB por defecto).
SMTP_RELAY_MAX_SIZE=26214400

# Captura de rebotes por VERP (opcional; necesita el relay encendido y el puerto 25 publicado
# hacia SMTP_RELAY_PORT, DEPLOY.md §D8). Sin definir, los rebotes del SMTP genérico no se capturan
# y no se rompe nada.
# SMTP_BOUNCE_DOMAIN=rebotes.tudominio.com

# --- Límites de envío por subcuenta (opcionales) ----------------------------
# Los valores guardados desde el panel de admin mandan sobre estos.
ENVIO_LIMITE_MINUTO=60
ENVIO_LIMITE_DIA=5000

# --- Worker de envío (opcional) ---------------------------------------------
# Mensajes que se envían en paralelo en esta instancia.
WORKER_CONCURRENCIA=5

# Ponlo a false para que esta instancia solo sirva la API y el panel, y ejecutar los workers en un
# servicio aparte. Con false, esta instancia NO envía correo.
WORKER_HABILITADO=true

# =============================================================================
# Solo para docker-compose (autohospedaje / local). En EasyPanel no hacen falta.
# =============================================================================
POSTGRES_DB=emails
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto

# Puerto del servidor donde se publica el panel.
APP_PORT=8080

# Los puertos del relay en el host los fijan SMTP_RELAY_PUBLIC_PORT y SMTP_RELAY_PUBLIC_PORT_SSL
# (arriba): docker-compose publica 587 → 2525 y 465 → 2465, igual que EasyPanel. En local no hay
# Traefik ni host público para el reto HTTP-01, así que compose arranca con SMTP_RELAY_TLS_AUTO=false
# y sin SMTP_RELAY_TRAEFIK_ACME (el relay usa el autofirmado provisional).
