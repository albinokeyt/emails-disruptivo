# =============================================================================
# Emails Disruptivo — variables de entorno
# Copia este fichero a .env y rellena los valores. Las marcadas OBLIGATORIA tienen
# que estar: sin ellas la app se niega a arrancar y dice cuál falta.
# =============================================================================

# Puerto HTTP del panel y de la API (en EasyPanel, 8080).
PORT=8080

# OBLIGATORIA. Postgres 17. En EasyPanel usa el host interno que te muestra el servicio.
DATABASE_URL=postgres://postgres:CAMBIA_ESTO@emails-db:5432/emails

# OBLIGATORIA. Redis 7: sesiones, locks de refresco de token y límites de envío.
REDIS_URL=redis://emails-redis:6379

# OBLIGATORIA. URL pública final, SIN barra al final y con HTTPS.
# Con ella se construyen la Redirect URL del OAuth, las URLs de seguimiento que van dentro de cada
# correo y las URLs de webhook que se registran en Brevo. Cambiarla después deja apuntando al
# dominio viejo todo el correo ya enviado.
APP_BASE_URL=https://emails.tudominio.com

# OBLIGATORIA. 32 bytes en base64 (o 64 caracteres hex). Cifra en AES-256-GCM las credenciales de
# los proveedores de correo. Genérala con:  openssl rand -base64 32
# Si la pierdes o la cambias, esas credenciales dejan de poder descifrarse y hay que volver a
# meterlas proveedor a proveedor. Para rotarla sin cortar el servicio se admiten varias separadas
# por comas: la primera cifra y todas se prueban al descifrar ("nueva,vieja").
ENCRYPTION_KEY=CAMBIA_ESTO

# OBLIGATORIAS. Login del panel de la agencia (/admin). Usa una contraseña larga y única.
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTO

# --- Relay SMTP (opcional; la sección activable del panel) -------------------
# Levanta el servidor SMTP que recibe el correo del nodo NATIVO de GoHighLevel.
# Déjalo en false hasta tener resuelto el puerto TCP y el certificado (DEPLOY.md §D).
SMTP_RELAY_ENABLED=false

# Puerto en el que escucha el relay DENTRO del contenedor.
SMTP_RELAY_PORT=2525

# Host que se le enseña al cliente para pegar en GHL › Settings › Email Services.
# Si se deja vacío, se usa el dominio de APP_BASE_URL.
SMTP_RELAY_HOST=smtp.tudominio.com

# Certificado TLS del host anterior, dentro del contenedor. Sin él solo hay STARTTLS oportunista
# con certificado autofirmado. Las dos van juntas: o las dos o ninguna.
# SMTP_RELAY_TLS_CERT=/certs/fullchain.pem
# SMTP_RELAY_TLS_KEY=/certs/privkey.pem

# Tamaño máximo de un mensaje entrante, en bytes (25 MB por defecto).
SMTP_RELAY_MAX_SIZE=26214400

# --- Límites de envío por subcuenta (opcionales) ----------------------------
# Los valores guardados desde el panel de admin mandan sobre estos.
ENVIO_LIMITE_MINUTO=60
ENVIO_LIMITE_DIA=5000

# --- Worker de envío (opcional) ---------------------------------------------
# Mensajes que se envían en paralelo en esta instancia.
WORKER_CONCURRENCIA=5

# Ponlo a false para que esta instancia solo sirva la API y el panel, y ejecutar los workers en un
# servicio aparte. Con false, esta instancia NO envía correo.
WORKER_HABILITADO=true

# =============================================================================
# Solo para docker-compose (autohospedaje / local). En EasyPanel no hacen falta.
# =============================================================================
POSTGRES_DB=emails
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto

# Puerto del servidor donde se publica el panel.
APP_PORT=8080

# Puerto del servidor donde se publica el relay SMTP (dentro del contenedor siempre es 2525).
SMTP_RELAY_PUBLIC_PORT=2525
